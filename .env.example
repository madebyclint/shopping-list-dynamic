# Database Configuration for Railway PostgreSQL
# These will be automatically set by Railway when deployed
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# For local development, you can use a local PostgreSQL instance
# DATABASE_URL=postgresql://username:password@localhost:5432/shopping_list

# OpenAI Configuration for AI Menu Generation
OPENAI_API_KEY=your_openai_api_key_here

# MCP connector access token(s) — format: label:token, comma-separated.
# This is what you type into the connector's sign-in page.
MCP_ACCESS_TOKENS=household:your_token_here

# --- Smoke test (npm run smoke:mcp) ---
# Token used to authenticate the smoke test. Must match the MCP_ACCESS_TOKENS
# value on the environment being tested. Leave blank if MCP_ACCESS_TOKENS above
# already holds that value. Either "label:token" or a bare token is accepted.
SMOKE_TOKEN=

# Client id created by `npm run smoke:token`. Step 7 asserts this client still
# resolves after a deploy, which is the regression test for OAuth state being
# lost on restart. Not a secret, and no token is minted for it.
SMOKE_CLIENT_ID=

# Override the target. Defaults to the production Railway URL.
# SMOKE_BASE_URL=http://localhost:8080

# Comma-separated names allowed to open /masterchef?chef=<name>.
# Unlisted, not authenticated — a wrong or missing name returns 404.
# MASTERCHEF_CHEFS=clintbush
